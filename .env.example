# .env.example を .env にコピーして使います (cp .env.example .env)
# どちらのキーも任意です。未設定の場合、その機能は画面上で無効になります。

# OpenAI: 文字起こしを OpenAI API (whisper-1) で行う場合
OPENAI_API_KEY=

# Anthropic: 回答内容の AI 講評 (Claude) を使う場合
ANTHROPIC_API_KEY=

# --- 以下は必要に応じて変更 ---
# ローカル Whisper のモデル (tiny / base / small / medium / large-v3-turbo / large-v3)
WHISPER_MODEL=large-v3-turbo
# 講評に使う Claude モデルと思考の深さ (low / medium / high / xhigh / max)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high
# 映像解析で 1 秒あたり何フレーム見るか
VISION_SAMPLE_FPS=8
